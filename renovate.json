{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "pnpm installed globally in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "npm install -g (?<depName>pnpm)@(?<currentValue>\\d[^\\s]*)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Go tools pinned via go install / go run",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "go (?:install|run) (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>v\\d[^\\s\"]*)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Keep package.json ranges in step with the lockfile; other managers (go directive, setup-go) keep the default so 1.27 is not pinned to a patch",
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Node runtime is pinned in .nvmrc, package.json engines and the web Dockerfile",
      "matchDepNames": [
        "node"
      ],
      "groupName": "node"
    },
    {
      "description": "packageManager and the Dockerfile pnpm install must stay in sync",
      "matchDepNames": [
        "pnpm"
      ],
      "groupName": "pnpm"
    },
    {
      "description": "Makefile and Dockerfile.dev pin the same generator; regenerated code must be committed by hand (make generate)",
      "matchPackageNames": [
        "github.com/oapi-codegen/oapi-codegen/v2"
      ],
      "groupName": "oapi-codegen"
    },
    {
      "description": "vue-tsc 3 does not support TypeScript 7 (no JS API); wait for stable vue-tsc 4",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Production runs Railway-managed Postgres 18; a major bump needs a dump/restore migration",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "<19"
    },
    {
      "description": "Low-risk automerge: dev tooling minor/patch. Renovate merges only after CI is green (no branch protection, so platform automerge is off)",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Low-risk automerge: GitHub Actions minor/patch/digest",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "orval updates need regenerated code committed (make generate), so never automerge",
      "matchPackageNames": [
        "orval"
      ],
      "automerge": false
    }
  ]
}